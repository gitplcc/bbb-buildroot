#!/bin/sh

DAEMON="lector-iio"
EXEC="/usr/bin/$DAEMON"
PIDFILE="/var/run/$DAEMON.pid"
DAEMON_ARGS="-c /etc/lector-iio/lector-iio.conf"
USER="lector-iio"
GROUP="lector-iio"

start() {
    printf "Starting %s: " "$DAEMON"
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -c "$USER:$GROUP" --exec "$EXEC" -- $DAEMON_ARGS
    [ $? = 0 ] && echo "OK" || echo "FAIL"
}

stop() {
    printf "Stopping %s: " "$DAEMON"
    start-stop-daemon -K -q -p "$PIDFILE" -u "$USER"
    [ $? = 0 ] && echo "OK" || echo "FAIL"
    rm -f "$PIDFILE"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac
