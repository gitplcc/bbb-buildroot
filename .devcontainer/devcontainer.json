{
    "name": "BeagleBone Black Buildroot Dev",
    "dockerComposeFile": "../compose.yaml",
    "service": "bbb-buildroot",
    "workspaceFolder": "/home/br-user/bbb-buildroot-project",
    "remoteUser": "br-user",
    "containerEnv": {
        "BR2_EXTERNAL": "/home/br-user/bbb-buildroot-project/bbb"
    },
    "updateContentCommand": "git submodule update --init --recursive",
    "customizations": {
        "vscode": {
            "settings": {
                "editor.formatOnSave": true
            },
            "extensions": [
                "microhobby.linuxkerneldev",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.makefile-tools",
                "redhat.vscode-yaml"
            ]
        }
    }
}
